---
import { loadVerify } from "../../lib/verify.js";
export const prerender = false;
const { id } = Astro.params;
const data = await loadVerify(id, Astro.url.origin);
const last = data.onchain[data.onchain.length - 1];
const hashEvento = last ? last.hashEvento : "";
const hashPDF = last ? last.hashPDF : "";
const contractAddress = import.meta.env.PUBLIC_CONTRACT_ADDRESS || "";
---
<h1>Transferir {id}</h1>
<p>Custodio actual (from): {data.custodio || "desconocido"}</p>
<p>Oráculo EIP-712: CustodiaActas v1 — contrato: {contractAddress}</p>
<form id="f">
  <label>From (emisor = custodio)<br /><input id="from" size="45" value={data.custodio || ""} /></label><br />
  <label>To (receptor)<br /><input id="to" size="45" placeholder="0x..." /></label><br />
  <label>hashEvento (editable)<br /><input id="hashEvento" size="70" value={hashEvento} /></label><br />
  <label>hashPDF (editable)<br /><input id="hashPDF" size="70" value={hashPDF} /></label><br />
  <label>nonce (editable, default 1)<br /><input id="nonce" type="number" min="1" value="1" /></label>
  <p><small>Ajusta si el recurso ya se transfirió antes (nonce = nº de transfers previas + 1).</small></p>
  <label>Firma receptor (sigTo — el receptor abre la misma URL en otro navegador, completa los mismos campos y firma)<br /><textarea id="sigTo" rows="4" cols="70" placeholder="0x..."></textarea></label><br />
  <button type="button" id="signFrom">Firmar como emisor</button>
  <button type="button" id="signTo">Firmar como receptor</button>
  <button type="submit">Enviar transfer</button>
</form>
<p id="out"></p>
<p id="sigs"></p>
<nav><a href="/">Inicio</a> | <a href={`/verify/${id}`}>Verificar</a></nav>
<script type="module" define:vars={{ resourceId: id, contractAddress }}>
  import { signTransfer } from "../../lib/transfer-sign.js";
  const $ = (id) => document.getElementById(id);
  let sigFrom = "";
  const isHash = (s) => /^0x[0-9a-fA-F]{64}$/.test(s || "");
  async function doSign() {
    const from = $("from").value.trim();
    const to = $("to").value.trim();
    const hashEvento = $("hashEvento").value.trim();
    const hashPDF = $("hashPDF").value.trim();
    const nonce = Number($("nonce").value);
    if (!from || !to || !hashEvento || !hashPDF) { $("out").textContent = "error: from/to/hashes requeridos"; return null; }
    if (!isHash(hashEvento) || !isHash(hashPDF)) { $("out").textContent = "error: hashes deben ser 0x-prefijo 66 chars"; return null; }
    if (!Number.isInteger(nonce) || nonce < 1) { $("out").textContent = "error: nonce >= 1"; return null; }
    return signTransfer({ contractAddress, from, to, resourceId, hashEvento, hashPDF, nonce });
  }
  $("signFrom").addEventListener("click", async () => {
    try {
      const sig = await doSign();
      if (!sig) return;
      sigFrom = sig;
      $("sigs").textContent = "sigFrom lista. Pega sigTo del receptor y envía.";
      $("out").textContent = "";
    } catch (err) { $("out").textContent = "error: " + String(err.message || err); }
  });
  $("signTo").addEventListener("click", async () => {
    try {
      const sig = await doSign();
      if (!sig) return;
      $("sigTo").value = sig;
      $("out").textContent = "firma receptor lista en sigTo.";
    } catch (err) { $("out").textContent = "error: " + String(err.message || err); }
  });
  $("f").addEventListener("submit", async (e) => {
    e.preventDefault();
    const from = $("from").value.trim();
    const to = $("to").value.trim();
    const hashEvento = $("hashEvento").value.trim();
    const hashPDF = $("hashPDF").value.trim();
    const sigTo = $("sigTo").value.trim();
    if (!sigFrom || !sigTo) { $("out").textContent = "error: se requieren sigFrom y sigTo"; return; }
    try {
      const r = await fetch(`/api/resources/${resourceId}/transfer`, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ from, to, hashEvento, hashPDF, sigFrom, sigTo }),
      });
      const j = await r.json();
      $("out").textContent = j.tx ? ("tx: " + j.tx) : ("error: " + (j.error || r.status));
    } catch (err) { $("out").textContent = "error: " + String(err.message || err); }
  });
</script>
